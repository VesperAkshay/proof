# ==============================================================================
# Proof (.env.example)
# Environment configuration template for Proof (proof.so)
# ==============================================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon Serverless PostgreSQL)
# Direct connection for migrations, DDL, schema locks
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/proof?sslmode=require"
# Pooled connection for Next.js serverless application queries
DATABASE_POOL_URL="postgresql://user:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/proof?sslmode=require"

# Authentication (Clerk - Auth sessions only; DB is handle authority)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_sample"
CLERK_SECRET_KEY="sk_test_sample"
CLERK_WEBHOOK_SECRET="whsec_sample"

# Object Storage (Cloudflare R2 - S3-compatible)
R2_ACCOUNT_ID="sample_account_id"
R2_ACCESS_KEY_ID="sample_access_key_id"
R2_SECRET_ACCESS_KEY="sample_secret_access_key"
R2_BUCKET_NAME="proof-assets"
R2_QUARANTINE_BUCKET_NAME="proof-quarantine"
R2_PUBLIC_URL="https://assets.proof.so"

# Queue (pg-boss schema prefix or configuration if customized)
PGBOSS_SCHEMA="pgboss"
